{
  "name": "chatme",
  "version": "1.0.0",
  "description": "A simple chatting up built with nodejs without framework like express",
  "main": "src",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node build/server.js",
    "start:dev": "npx cross-env NODE_ENV=development ts-node src/server.ts",
    "db:migrate": "ts-node src/database/migration/index.ts",
    "build": "tsc",
    "lint": "./node_modules/.bin/eslint . --ext .ts --fix",
    "postinstall": "npm-run-all lint build db:migrate"
  },
  "author": "Daniel Mwangila",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.5",
    "@types/formidable": "^3.4.5",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.11.13",
    "@types/qs": "^6.9.18",
    "@types/route-parser": "^0.1.7",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "formidable": "^3.5.3",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "pg": "^8.14.1",
    "qs": "^6.14.0",
    "route-parser": "^0.0.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "nodemonConfig": {
    "exec": "npm run start:dev",
    "ext": "ts",
    "ignore": [
      "build/*"
    ]
  }
}
